pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t jenkins-docker-app .'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'docker run --rm jenkins-docker-app python -m pytest -v'
            }
        }

        stage('Deploy Container') {
            steps {
                bat '''
                docker rm -f jenkins-docker-container
                docker run -d -p 5000:5000 --name jenkins-docker-container jenkins-docker-app
                '''
            }
        }
    }
}