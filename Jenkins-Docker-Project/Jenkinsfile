pipeline {
    agent any

    environment {
        DOCKER = 'C:\\Users\\SWETA\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Jenkins-Docker-Project') {
                    bat '"%DOCKER%" build -t jenkins-docker-app .'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('Jenkins-Docker-Project') {
                    bat '"%DOCKER%" run --rm jenkins-docker-app python -m pytest -v'
                }
            }
        }

        stage('Deploy Container') {
            steps {
                bat '''
                "%DOCKER%" rm -f jenkins-docker-container 2>NUL
                "%DOCKER%" run -d -p 5000:5000 --name jenkins-docker-container jenkins-docker-app
                '''
            }
        }
    }
}